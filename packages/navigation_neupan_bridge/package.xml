<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navigation_neupan_bridge</name>
  <version>0.1.0</version>
  <description>Nav2 Humble controller adapter for the R1 NeuPAN HW0 shadow stack.</description>
  <maintainer email="rpp@robotplusplus.com.cn">rpp</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometric_shapes</depend>
  <depend>geometry_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>r1_description</exec_depend>
  <exec_depend>r1_lidar_preprocess</exec_depend>
  <exec_depend>r1_collision_guard</exec_depend>
  <exec_depend>r1_neupan_integration</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
