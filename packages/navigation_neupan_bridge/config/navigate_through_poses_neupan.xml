<!-- One path retry after controller failure; no recovery motion. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1" name="ReplanThroughPosesAfterFailure">
      <PipelineSequence name="NavigateThroughPosesWithNeuPANReplanning">
        <RateController hz="1.0">
          <Fallback>
            <Sequence>
              <ComputePathThroughPoses goals="{goals}" path="{candidate_path}" planner_id="GridBased"/>
              <AcceptNeuPANPath candidate_path="{candidate_path}" goals="{goals}" path="{path}" accepted_goals="{accepted_goals}"/>
            </Sequence>
            <IsNeuPANWaiting path="{path}" goals="{goals}" accepted_goals="{accepted_goals}"/>
          </Fallback>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath"/>
      </PipelineSequence>
      <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
    </RecoveryNode>
  </BehaviorTree>
</root>
